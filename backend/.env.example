APP_NAME=BidGuard AI
APP_ENV=development

ORACLE_USER=BIDGUARD_AI
ORACLE_PASSWORD=
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
# Existing SIH synthetic dataset root used only by seed scripts.
# BIDGUARD_DATA_ROOT=/home/tarun/TARUN/projects/test-sih-docs

# Defaults to <project>/storage/uploads when omitted.
# STORAGE_ROOT=/absolute/path/to/bidguard-ai/storage/uploads

# Demo-only: permit pre-seeded synthetic submissions with no bidder_documents
# rows to read PDFs from PROTOTYPE_DATASET_ROOT. Imported submissions never fall
# back when any stored document rows exist.
ALLOW_PRESEEDED_PROTOTYPE_DOCUMENT_FALLBACK=true

# Rotating workflow logs. Defaults to backend/logs, 10 MB, 5 backups.
# LOG_ROOT=/absolute/path/to/bidguard-ai/backend/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

MAX_UPLOAD_FILES=100
MAX_ARCHIVE_BYTES=104857600
MAX_PDF_BYTES=26214400
MAX_TOTAL_PDF_BYTES=209715200
MAX_ZIP_COMPRESSION_RATIO=100
